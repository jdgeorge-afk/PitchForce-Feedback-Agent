# PitchForce Feedback configuration. Copy to .env and adjust. Never commit .env.
# All values are read server-side only.

# --- Core -------------------------------------------------------------------
# Random secret used to sign session cookies and share links. REQUIRED in production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
# development | production | test   (production refuses to start with the default SECRET_KEY)
ENVIRONMENT=development
# Where the database (SQLite default) and private file storage live.
DATA_DIR=./data
# Leave empty for SQLite in DATA_DIR. For PostgreSQL: postgresql+psycopg://user:pass@host:5432/pitchforce
DATABASE_URL=
# Public base URL of this app (used to build expiring share links).
BASE_URL=http://127.0.0.1:8000
# Set true when served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=12

# Optional: create the first administrator at startup (otherwise use the /setup page).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Uploads ----------------------------------------------------------------
# Max video upload (MB) and max document upload (MB).
MAX_UPLOAD_MB=8192
MAX_DOCUMENT_UPLOAD_MB=100
# Chunk size for resumable uploads (MB).
UPLOAD_CHUNK_MB=8
ALLOWED_VIDEO_EXT=.mp4,.m4v,.mov,.mkv,.webm,.avi
# Safe archive extraction limits (best-practices ZIP uploads).
ZIP_MAX_FILES=200
ZIP_MAX_TOTAL_MB=300
ZIP_MAX_RATIO=100

# --- Background worker --------------------------------------------------------
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1.0

# --- Media ------------------------------------------------------------------
# Leave empty to use the FFmpeg binary bundled with the imageio-ffmpeg package.
FFMPEG_PATH=
CLIP_RENDER_TIMEOUT_S=3600

# --- AI analysis (optional) -------------------------------------------------
# offline   = deterministic rule-based analysis; no data leaves the server (default)
# anthropic = Claude via the Anthropic API; transcript excerpts are sent to Anthropic
AI_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (Claude API only)
ANTHROPIC_FALLBACKS=true
# USD per million tokens, used only for the cost estimates shown to operators. Verify current pricing.
AI_PRICE_INPUT_PER_MTOK=4.0
AI_PRICE_OUTPUT_PER_MTOK=20.0

# --- Transcription (optional) -----------------------------------------------
# none | openai_compatible   (any Whisper-compatible /audio/transcriptions endpoint returning VTT)
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_PRICE_PER_MINUTE=0.006

# --- Official EcoVG content ---------------------------------------------------
CALENDAR_URLS=https://events.ecovg.com/events
CALENDAR_ALLOWED_HOSTS=ecovg.com,events.ecovg.com,www.ecovg.com,events.pitch-force.com
CALENDAR_CACHE_HOURS=24
ADVISORY_URL=https://ecovg.com/entrepreneur-services/
# Set false to disable all outbound fetching (calendar retrieval).
OUTBOUND_FETCH_ENABLED=true

# --- Sharing and retention -----------------------------------------------------
SHARE_LINK_DAYS=14
# Delete archived events (and their files) after this many days. 0 = never automatically.
RETENTION_DAYS=0
